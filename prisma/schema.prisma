generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                                     String                            @id @default(cuid())
  name                                   String
  slug                                   String                            @unique
  logo                                   String?
  themeColor                             String                            @default("#6366f1")
  address                                String?
  phone                                  String?
  email                                  String?
  website                                String?
  gstNumber                              String?
  directorSign                           String?
  isActive                               Boolean                           @default(true)
  trialEndsAt                            DateTime?
  createdAt                              DateTime                          @default(now())
  updatedAt                              DateTime                          @updatedAt
  schoolCode                             String?
  diseCode                               String?
  upiId                                  String?
  bankAccountNo                          String?
  ifscCode                               String?
  totalEarnings                          Float                             @default(0)
  availableBalance                       Float                             @default(0)
  affiliateId                            String?
  referralLocked                         Boolean                           @default(false)
  globalAffiliateMarketplaceCommissions  AffiliateMarketplaceCommission[]
  globalAffiliateReferral                AffiliateReferral?
  globalAffiliateSubscriptionCommissions AffiliateSubscriptionCommission[]
  withdrawals                            AffiliateWithdrawal[]
  attendances                            Attendance[]
  auditLogs                              AuditLog[]
  batches                                Batch[]
  branches                               Branch[]
  chatMessages                           ChatMessage[]
  courses                                Course[]
  driverProfiles                         DriverProfile[]
  exams                                  Exam[]
  examResults                            ExamResult[]
  expenses                               Expense[]
  fees                                   Fee[]
  affiliateOrders                        GyankoshOrder[]                   @relation("TenantAffiliateOrders")
  homeworks                              Homework[]
  homeworkSubmissions                    HomeworkSubmission[]
  leads                                  Lead[]
  leaveApplications                      LeaveApplication[]
  mockTests                              MockTest[]
  notifications                          Notification[]
  parentProfiles                         ParentProfile[]
  payments                               Payment[]
  pushSubscriptions                      PushSubscription[]
  questions                              Question[]
  results                                Result[]
  students                               Student[]
  subscriptions                          Subscription?
  teachers                               Teacher[]
  teacherSalaryLedgers                   TeacherSalaryLedger[]
  affiliate                              Affiliate?                        @relation(fields: [affiliateId], references: [id])
  timeTables                             TimeTable[]
  transportLogs                          TransportLog[]
  users                                  User[]
  vehicles                               Vehicle[]
  vehicleLocations                       VehicleLocation[]
  sports                                 Sport[]
  studentSports                          StudentSport[]
}

model Affiliate {
  id                      String                            @id @default(cuid())
  name                    String
  email                   String                            @unique
  phone                   String?
  password                String
  plainPassword           String?
  resetToken              String?                           @unique
  resetTokenExpiry        DateTime?
  affiliateCode           String                            @unique
  bankAccountNumber       String?
  ifscCode                String?
  upiId                   String?
  status                  String                            @default("ACTIVE")
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  marketplaceCommissions  AffiliateMarketplaceCommission[]
  payouts                 AffiliatePayout[]
  referrals               AffiliateReferral[]
  subscriptionCommissions AffiliateSubscriptionCommission[]
  tenants                 Tenant[]
}

model AffiliateReferral {
  id           String    @id @default(cuid())
  affiliateId  String
  tenantId     String    @unique
  referralDate DateTime  @default(now())
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
}

model AffiliateSubscriptionCommission {
  id                   String    @id @default(cuid())
  affiliateId          String
  tenantId             String
  subscriptionId       String?
  paymentAmount        Float
  commissionPercentage Float
  commissionAmount     Float
  commissionType       String
  month                String
  status               String    @default("PENDING")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  affiliate            Affiliate @relation(fields: [affiliateId], references: [id])
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
}

model AffiliateMarketplaceCommission {
  id                   String        @id @default(cuid())
  affiliateId          String
  tenantId             String
  orderId              String        @unique
  orderAmount          Float
  commissionPercentage Float         @default(20.0)
  commissionAmount     Float
  month                String
  status               String        @default("PENDING")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  affiliate            Affiliate     @relation(fields: [affiliateId], references: [id])
  order                GyankoshOrder @relation(fields: [orderId], references: [id])
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
}

model AffiliatePayout {
  id                          String    @id @default(cuid())
  affiliateId                 String
  month                       String
  totalSubscriptionCommission Float     @default(0)
  totalMarketplaceCommission  Float     @default(0)
  totalPayoutAmount           Float     @default(0)
  payoutStatus                String    @default("PENDING")
  payoutDate                  DateTime?
  transactionReference        String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  affiliate                   Affiliate @relation(fields: [affiliateId], references: [id])
}

model User {
  id               String         @id @default(cuid())
  tenantId         String
  email            String
  phone            String?
  password         String
  plainPassword    String?
  resetToken       String?        @unique
  resetTokenExpiry DateTime?
  name             String
  role             UserRole       @default(STAFF)
  avatar           String?
  isActive         Boolean        @default(true)
  lastLogin        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  auditLogs        AuditLog[]
  driverProfile    DriverProfile?
  parentProfile    ParentProfile?
  studentProfile   Student?
  teacherProfile   Teacher?
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Branch {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  batches   Batch[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  Student[]

  @@index([tenantId])
}

model Course {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  duration         String?
  fees             Float     @default(0)
  subjects         String[]
  installmentCount Int       @default(1)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  batches          Batch[]
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exams            Exam[]
  students         Student[]

  @@index([tenantId])
}

model Batch {
  id          String       @id @default(cuid())
  tenantId    String
  courseId    String
  branchId    String?
  name        String
  startTime   String?
  endTime     String?
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int          @default(30)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  branch      Branch?      @relation(fields: [branchId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exams       Exam[]
  homeworks   Homework[]
  mockTests   MockTest[]
  students    Student[]
  timeTables  TimeTable[]

  @@index([tenantId])
}

model Student {
  id                  String               @id @default(cuid())
  tenantId            String
  courseId            String
  batchId             String
  branchId            String?
  studentId           String?
  userId              String?              @unique
  fullName            String
  fatherName          String?
  motherName          String?
  phone               String
  parentPhone         String?
  email               String?
  address             String?
  dob                 DateTime?
  gender              Gender               @default(MALE)
  photo               String?
  idProof             String?
  aadhaarNo           String?
  penId               String?
  aparId              String?
  samagraId           String?
  admissionDate       DateTime             @default(now())
  feePlan             String?
  totalFee            Float                @default(0)
  paidFee             Float                @default(0)
  status              StudentStatus        @default(ACTIVE)
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  vehicleId           String?
  bankAccountNo       String?
  bankName            String?
  caste               String?
  dobInWords          String?
  firstAdmissionClass String?
  firstAdmissionDate  DateTime?
  ifscCode            String?
  medium              String?
  scholarNo           String?
  scholarshipScheme   String?
  subjectGroup        String?
  attendances         Attendance[]
  examResults         ExamResult[]
  fees                Fee[]
  homeworkSubmissions HomeworkSubmission[]
  payments            Payment[]
  results             Result[]
  batch               Batch                @relation(fields: [batchId], references: [id])
  branch              Branch?              @relation(fields: [branchId], references: [id])
  course              Course               @relation(fields: [courseId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccount         User?                @relation(fields: [userId], references: [id])
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id])
  transportLogs       TransportLog[]
  parentLinks         ParentProfile[]      @relation("ParentChildren")
  studentSports       StudentSport[]

  @@index([tenantId])
  @@index([tenantId, fullName])
  @@index([tenantId, phone])
}

model Teacher {
  id                String                @id @default(cuid())
  tenantId          String
  name              String
  email             String?
  phone             String
  subject           String[]
  salary            Float                 @default(0)
  joinDate          DateTime              @default(now())
  photo             String?
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  userId            String?               @unique
  attendances       Attendance[]
  leaveApplications LeaveApplication[]
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccount       User?                 @relation(fields: [userId], references: [id])
  salaryLedgers     TeacherSalaryLedger[]
  timeTables        TimeTable[]

  @@index([tenantId])
}

model Fee {
  id        String    @id @default(cuid())
  tenantId  String
  studentId String
  amount    Float
  dueDate   DateTime
  paidDate  DateTime?
  status    FeeStatus @default(PENDING)
  lateFee   Float     @default(0)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  student   Student   @relation(fields: [studentId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([tenantId])
  @@index([tenantId, studentId])
}

model Payment {
  id         String      @id @default(cuid())
  tenantId   String
  studentId  String
  feeId      String?
  amount     Float
  mode       PaymentMode @default(CASH)
  reference  String?
  receivedBy String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  receiptNo  String?
  fee        Fee?        @relation(fields: [feeId], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, receiptNo])
}

model Attendance {
  id        String           @id @default(cuid())
  tenantId  String
  studentId String?
  teacherId String?
  batchId   String?
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  markedBy  String?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  inTime    DateTime?
  outTime   DateTime?
  batch     Batch?           @relation(fields: [batchId], references: [id])
  student   Student?         @relation(fields: [studentId], references: [id])
  teacher   Teacher?         @relation(fields: [teacherId], references: [id])
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, date])
}

model MockTest {
  id            String     @id @default(cuid())
  tenantId      String
  batchId       String?
  title         String
  subject       String?
  type          TestType   @default(MCQ)
  duration      Int        @default(60)
  totalMarks    Float      @default(100)
  passingMarks  Float      @default(40)
  negativeMarks Float      @default(0)
  startTime     DateTime?
  endTime       DateTime?
  isPublished   Boolean    @default(false)
  instructions  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  batch         Batch?     @relation(fields: [batchId], references: [id])
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions     Question[]
  results       Result[]

  @@index([tenantId])
}

model Question {
  id            String       @id @default(cuid())
  tenantId      String
  mockTestId    String?
  subject       String
  topic         String?
  questionText  String
  type          QuestionType @default(MCQ)
  options       Json?
  correctAnswer String?
  marks         Float        @default(1)
  difficulty    Difficulty   @default(MEDIUM)
  explanation   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  mockTest      MockTest?    @relation(fields: [mockTestId], references: [id])
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Result {
  id            String   @id @default(cuid())
  tenantId      String
  studentId     String
  mockTestId    String
  totalMarks    Float    @default(0)
  obtainedMarks Float    @default(0)
  percentage    Float    @default(0)
  rank          Int?
  answers       Json?
  timeTaken     Int?
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  mockTest      MockTest @relation(fields: [mockTestId], references: [id])
  student       Student  @relation(fields: [studentId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  category    String
  amount      Float
  date        DateTime
  description String?
  paidTo      String?
  receipt     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Lead {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  phone        String
  email        String?
  course       String?
  source       String?
  status       LeadStatus @default(NEW)
  followUpDate DateTime?
  notes        String?
  assignedTo   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  message   String
  direction String
  status    String   @default("SENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  plan               SubscriptionPlan   @default(BASIC)
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  razorpaySubId      String?
  amount             Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Notification {
  id         String   @id @default(cuid())
  tenantId   String
  title      String
  message    String
  type       String   @default("INFO")
  isRead     Boolean  @default(false)
  targetRole String?
  targetId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model GyankoshProduct {
  id          String              @id @default(cuid())
  title       String
  description String?
  category    CategoryType        @default(COURSE_MATERIAL)
  price       Float               @default(0)
  discount    Float               @default(0)
  imageUrl    String?
  fileUrl     String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  bonuses     GyankoshBonus[]
  orders      GyankoshOrder[]
  orderBumps  GyankoshOrderBump[]
}

model GyankoshBonus {
  id            String          @id @default(cuid())
  productId     String
  title         String
  description   String?
  imageUrl      String?
  fileUrl       String?
  originalPrice Float           @default(0)
  product       GyankoshProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model GyankoshOrderBump {
  id              String          @id @default(cuid())
  productId       String
  title           String
  description     String?
  imageUrl        String?
  fileUrl         String?
  originalPrice   Float           @default(0)
  discountedPrice Float           @default(0)
  product         GyankoshProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model GyankoshOrder {
  id                        String                          @id @default(cuid())
  productId                 String?
  items                     Json?
  orderBumpIds              String[]
  studentName               String
  email                     String
  phone                     String
  amount                    Float
  status                    OrderStatus                     @default(PENDING)
  razorpayOrderId           String?
  razorpayPaymentId         String?
  affiliateTenantId         String?
  commissionAmount          Float                           @default(0)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  globalAffiliateCommission AffiliateMarketplaceCommission?
  tenant                    Tenant?                         @relation("TenantAffiliateOrders", fields: [affiliateTenantId], references: [id])
  product                   GyankoshProduct?                @relation(fields: [productId], references: [id])
}

model AffiliateWithdrawal {
  id          String           @id @default(cuid())
  tenantId    String
  amount      Float
  status      WithdrawalStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  processedAt DateTime?
  notes       String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Homework {
  id            String               @id @default(cuid())
  tenantId      String
  batchId       String
  teacherId     String?
  title         String
  description   String?
  subject       String?
  dueDate       DateTime?
  attachmentUrl String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  batch         Batch                @relation(fields: [batchId], references: [id])
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions   HomeworkSubmission[]

  @@index([tenantId])
  @@index([tenantId, batchId])
}

model HomeworkSubmission {
  id            String           @id @default(cuid())
  tenantId      String
  homeworkId    String
  studentId     String
  content       String?
  attachmentUrl String?
  status        SubmissionStatus @default(SUBMITTED)
  grade         String?
  feedback      String?
  submittedAt   DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  homework      Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id])
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([tenantId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([tenantId])
  @@index([userId])
}

model ParentProfile {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String    @unique
  name      String
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
  children  Student[] @relation("ParentChildren")

  @@index([tenantId])
}

model Exam {
  id        String       @id @default(cuid())
  tenantId  String
  title     String
  date      DateTime     @default(now())
  subject   String
  maxMarks  Float
  courseId  String
  batchId   String
  teacherId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  batch     Batch        @relation(fields: [batchId], references: [id])
  course    Course       @relation(fields: [courseId], references: [id])
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  results   ExamResult[]

  @@index([tenantId])
  @@index([courseId, batchId])
}

model ExamResult {
  id            String   @id @default(cuid())
  tenantId      String
  examId        String
  studentId     String
  marksObtained Float
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model Vehicle {
  id             String            @id @default(cuid())
  tenantId       String
  registrationNo String
  routeDetails   String?
  capacity       Int               @default(40)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  driverProfiles DriverProfile[]
  students       Student[]
  transportLogs  TransportLog[]
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations      VehicleLocation[]

  @@index([tenantId])
}

model DriverProfile {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  vehicleId String?
  licenseNo String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
}

model TransportLog {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  vehicleId String
  driverId  String
  status    String
  timestamp DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, timestamp])
}

model VehicleLocation {
  id        String   @id @default(cuid())
  tenantId  String
  vehicleId String
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  timestamp DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, timestamp])
}

model LeaveApplication {
  id        String      @id @default(cuid())
  tenantId  String
  teacherId String
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TeacherSalaryLedger {
  id         String       @id @default(cuid())
  tenantId   String
  teacherId  String
  month      Int
  year       Int
  baseSalary Float
  deductions Float        @default(0)
  netPayable Float
  status     SalaryStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  teacher    Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teacherId, month, year])
  @@index([tenantId])
}

model TimeTable {
  id        String          @id @default(cuid())
  tenantId  String
  teacherId String
  batchId   String
  subject   String
  dayOfWeek Int
  startTime String
  endTime   String
  status    TimeTableStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  batch     Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher   Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

